<table class="table table-hover table-striped table-sm table-responsive small">
    <tr>
        <th>Trace ID</th>
        <td>{{ trace_id }}</td>
    </tr>
    <tr>
        <th>Network</th>
        <td>{{ network }}</td>
    </tr>
    <tr>
        <th>Station</th>
        <td>{{ station }}</td>
    </tr>
    <tr>
        <th>Location</th>
        <td>{{ location }}</td>
    </tr>
    <tr>
        <th>Channel</th>
        <td>{{ channel }}</td>
    </tr>
    <tr>
        <th>Start time</th>
        <td>{{ start_time }}</td>
    </tr>
    <tr>
        <th>End time</th>
        <td>{{ end_time }}</td>
    </tr>
    <tr>
        <th>Sampling rate</th>
        <td>{{ sampling_rate }} Hz</td>
    </tr>
    <tr>
        <th>Samples</th>
        <td>{{ n_points }}</td>
    </tr>
</table>
